#include <iostream>
using namespace std;

int main() {
    float numero1, numero2, resultado;

    cout << "Ingrese el primer numero: ";
    cin >> numero1;

    cout << "Ingrese el segundo numero: ";
    cin >> numero2;

    if (numero2 == 0) {
        cout << "Error: No se puede dividir entre cero." << endl;
    } else {
        resultado = numero1 / numero2;
        cout << "Resultado: " << resultado << endl;
    }

    return 0;
}
